{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lch:schema:0.1:action-graph",
  "title": "Lossless Context Handoff action graph v0.1",
  "description": "One immutable, event-activated action graph revision.",
  "x-lch-schema-version": "0.1.0",
  "type": "object",
  "required": [
    "action_graph_revision",
    "actions",
    "action_edges",
    "action_groups",
    "recommendation_basis_ids"
  ],
  "properties": {
    "action_graph_revision": {
      "$ref": "#/$defs/revision"
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "action_edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "action_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "recommended_action_id": {
      "oneOf": [
        {
          "$ref": "urn:lch:schema:0.1:common#/$defs/stableId"
        },
        {
          "type": "null"
        }
      ]
    },
    "recommendation_basis_ids": {
      "type": "array",
      "items": {
        "$ref": "urn:lch:schema:0.1:common#/$defs/stableId"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$comment": "A deterministic validator must enforce unique IDs, all cross-references, revision lineage, event-head agreement, normalized EXCLUDES edges, and a DAG for REQUIRES and BEFORE dependencies. JSON Schema alone cannot establish those graph invariants.",
  "$defs": {
    "revision": {
      "type": "object",
      "required": [
        "record_id",
        "revision_id",
        "previous_revision_ids",
        "activated_by_event_id",
        "revision_digest"
      ],
      "properties": {
        "record_id": {
          "$ref": "urn:lch:schema:0.1:common#/$defs/stableId"
        },
        "revision_id": {
          "$ref": "urn:lch:schema:0.1:common#/$defs/stableId"
        },
        "previous_revision_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:lch:schema:0.1:common#/$defs/stableId"
          },
          "uniqueItems": true
        },
        "activated_by_event_id": {
          "$ref": "urn:lch:schema:0.1:common#/$defs/stableId"
        },
        "revision_digest": {
          "$ref": "urn:lch:schema:0.1:common#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": [
        "action_id",
        "next_action_record_id",
        "eligibility_projection",
        "event_head_ids",
        "completion_criteria",
        "required_capabilities",
        "required_authorization_specs",
        "external_state_checks"
      ],
      "properties": {
        "action_id": {
          "$ref": "urn:lch:schema:0.1:common#/$defs/stableId"
        },
        "next_action_record_id": {
          "$ref": "urn:lch:schema:0.1:common#/$defs/stableId"
        },
        "eligibility_projection": {
          "enum": [
            "READY",
            "BLOCKED",
            "COMPLETED",
            "SUPERSEDED"
          ]
        },
        "event_head_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:lch:schema:0.1:common#/$defs/stableId"
          },
          "uniqueItems": true
        },
        "completion_criteria": {
          "type": "array"
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "$ref": "urn:lch:schema:0.1:common#/$defs/stableId"
          },
          "uniqueItems": true
        },
        "required_authorization_specs": {
          "type": "array",
          "items": {
            "$ref": "urn:lch:schema:0.1:common#/$defs/stableId"
          },
          "uniqueItems": true
        },
        "external_state_checks": {
          "type": "array",
          "items": {
            "$ref": "urn:lch:schema:0.1:common#/$defs/stableId"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "edge_id",
        "source_action_id",
        "target_action_id",
        "relation",
        "condition_id"
      ],
      "properties": {
        "edge_id": {
          "$ref": "urn:lch:schema:0.1:common#/$defs/stableId"
        },
        "source_action_id": {
          "$ref": "urn:lch:schema:0.1:common#/$defs/stableId"
        },
        "target_action_id": {
          "$ref": "urn:lch:schema:0.1:common#/$defs/stableId"
        },
        "relation": {
          "enum": [
            "REQUIRES",
            "BEFORE",
            "ENABLES",
            "EXCLUDES"
          ]
        },
        "condition_id": {
          "oneOf": [
            {
              "$ref": "urn:lch:schema:0.1:common#/$defs/stableId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "required": [
        "group_id",
        "kind",
        "member_action_ids"
      ],
      "properties": {
        "group_id": {
          "$ref": "urn:lch:schema:0.1:common#/$defs/stableId"
        },
        "kind": {
          "enum": [
            "PARALLEL",
            "EXACTLY_ONE",
            "AT_LEAST_ONE",
            "ORDERED"
          ]
        },
        "member_action_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:lch:schema:0.1:common#/$defs/stableId"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  }
}
